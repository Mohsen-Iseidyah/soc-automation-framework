# ---------------------------------------------------------------
# Copy this file to .env in the same directory, then fill in real
# values. Never commit the .env file itself.
#
#   cp .env.example .env
#
# Generate strong secrets with:
#   openssl rand -base64 32
# ---------------------------------------------------------------

# IP address of the host running the stack. Used for MISP's base
# URL, the n8n host, and the webhook URL that Wazuh calls.
# Must be reachable from the Wazuh server and the endpoints.
HOST_IP=192.168.1.10

# --- MISP database (MySQL) ---
MISP_DB_PASSWORD=change_me
MISP_DB_ROOT_PASSWORD=change_me

# --- n8n ---
# Database password for the n8n PostgreSQL backend.
N8N_DB_PASSWORD=change_me
# Encrypts stored credentials inside n8n. Losing this value makes
# every saved credential unreadable — back it up somewhere safe.
N8N_ENCRYPTION_KEY=change_me

# --- MinIO (object storage used by TheHive) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# --- Cortex ---
# Host directory Cortex uses as a working directory for analyser
# jobs. Must exist and be writable by the Cortex container.
CORTEX_JOB_DIR=/opt/cortex/jobs
