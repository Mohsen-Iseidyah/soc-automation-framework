<group name="local,syslog,sshd,">

  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="windows,sysmon,local,ioc,">

  <rule id="100300" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^PING\.EXE$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bping(\.exe)?\b.+\b(?:\d{1,3}\.){3}\d{1,3}\b</field>
    <options>no_full_log</options>
    <description>IOC IP detected in ping command line: $(win.eventdata.commandLine)</description>
    <group>sysmon_event1,ioc_ip,ping_cmd,windows,sysmon,</group>
  </rule>

  

  <rule id="100302" level="7">
    <if_sid>61650</if_sid>
    <field name="win.eventdata.queryName" type="pcre2">(?i)\b[a-z0-9][a-z0-9.-]*\.[a-z]{2,}\b</field>
    <options>no_full_log</options>
    <description>IOC domain detected in DNS query: $(win.eventdata.queryName)</description>
    <group>sysmon_event_22,ioc_domain,dns_query,windows,sysmon,</group>
  </rule>

  <rule id="100303" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^TRACERT\.EXE$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\btracert(\.exe)?\b.+\b(?:\d{1,3}\.){3}\d{1,3}\b</field>
    <options>no_full_log</options>
    <description>IOC IP detected in tracert command line: $(win.eventdata.commandLine)</description>
    <group>sysmon_event1,ioc_ip,tracert_cmd,windows,sysmon,</group>
  </rule>

  

<rule id="100305" level="7">
  <if_sid>61603</if_sid>
  <field name="win.eventdata.originalFileName" type="pcre2">(?i)^curl\.exe$</field>
  <field name="win.eventdata.commandLine" type="pcre2">(?i)\bcurl(\.exe)?\b.+\b(?:\d{1,3}\.){3}\d{1,3}\b</field>
  <options>no_full_log</options>
  <description>IOC IP detected in curl command line: $(win.eventdata.commandLine)</description>
  <group>sysmon_event1,ioc_ip,curl_cmd,windows,sysmon,</group>
</rule>


</group>

<!-- Modify it at your will. -->

<group name="custom_sysmon,windows,suspicious_network,">
  <rule id="100010" level="7">
  <if_group>windows</if_group>
  <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
  <field name="win.system.eventID">^3$</field>
  <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
  <field name="win.eventdata.destinationIp" type="pcre2">^(?:\d{1,3}\.){3}\d{1,3}$</field>
  <field name="win.system.message" type="pcre2" negate="yes">(?i)(Invoke-WebRequest|iwr|Net\.WebClient|System\.Net\.WebRequest)</field>
  <description>IOC IP detected in PowerShell network connection: $(win.eventdata.destinationIp):$(win.eventdata.destinationPort)</description>
  <group>custom_sysmon,windows,suspicious_network,sysmon_event3,ioc_ip,powershell_network,</group>
  <mitre>
    <id>T1059.001</id>
    <id>T1043</id>
  </mitre>
</rule>
  
  <rule id="100308" level="8">
  <if_sid>92027</if_sid>
  <field name="win.eventdata.commandLine" type="pcre2">(?i)Invoke-WebRequest.+-Uri\s+https?://(?:\d{1,3}\.){3}\d{1,3}\b</field>
  <options>no_full_log</options>
  <description>IOC IP detected in PowerShell Invoke-WebRequest command: $(win.eventdata.commandLine)</description>
  <group>sysmon_event1,ioc_ip,powershell_iwr,windows,sysmon,</group>
</rule>


<rule id="100309" level="7">
  <if_sid>61603</if_sid>
  <field name="win.eventdata.originalFileName" type="pcre2">(?i)^nslookup\.exe$</field>
  <field name="win.eventdata.commandLine" type="pcre2">(?i)\bnslookup(\.exe)?\b\s+.+</field>
  <options>no_full_log</options>
  <description>IOC detected in nslookup command line: $(win.eventdata.commandLine)</description>
  <group>sysmon_event1,ioc_lookup,nslookup_cmd,windows,sysmon,</group>
</rule>

<!-- curl with URL/domain -> Event 1 -->

  <!-- curl with URL/domain -> Event 1 -->
  <rule id="100316" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^curl\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bcurl(\.exe)?\b.+https?://\S+</field>
    <options>no_full_log</options>
    <description>IOC URL detected in curl command line: $(win.eventdata.commandLine)</description>
    <group>sysmon_event1,ioc_url,curl_cmd,windows,sysmon,</group>
  </rule>


  <rule id="100420" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)CertUtil\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\-urlcache</field>
    <description>CertUtil urlcache download detected</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <options>no_full_log</options>
  </rule>
  
  



</group>
